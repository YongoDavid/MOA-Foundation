# TEMPLATE ONLY — never put real values in this file. It is COMMITTED.
#
# Copy it to .env.local (which .gitignore covers) and fill that in instead:
#     cp .env.example .env.local
#
# Next.js reads .env.local. It does NOT read .env.example, so filling this one
# in leaves the app unconfigured AND puts secrets in git.

# Public site URL — drives canonical and Open Graph URLs (see src/app/layout.jsx).
# Confirmed production domain, 24 August 2026.
NEXT_PUBLIC_SITE_URL=

# ── Supabase ────────────────────────────────────────────────────────────────
# Posts, comments, staff auth. Dashboard → Project Settings → API Keys.
#
# Supabase renamed these. The dashboard now offers PUBLISHABLE and SECRET keys
# alongside the legacy `anon` / `service_role` pair. Use the NEW ones — legacy
# still works but is on the way out.
#
#   Publishable  (sb_publishable_…)  replaces  anon          → safe in a browser
#   Secret       (sb_secret_…)       replaces  service_role  → SERVER ONLY
#
# The bare Project URL, e.g. https://abcdefgh.supabase.co
# NOT the REST endpoint (.../rest/v1/) shown beside it on the same page.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEVER prefix this one NEXT_PUBLIC_. That prefix compiles the value into the
# JavaScript bundle and ships it to every visitor, and this key bypasses every
# row-level security policy — full read and write on the whole database.
SUPABASE_SECRET_KEY=

# ── Resend ──────────────────────────────────────────────────────────────────
# Transactional email for the five forms. Requires a VERIFIED DOMAIN: you
# cannot send as @gmail.com, because authentication needs DNS records on a
# domain you control.
RESEND_API_KEY=
# The From address. Must be at the verified domain.
RESEND_FROM=
# Where submissions land, and where replies go. The Foundation's working inbox.
FORMS_TO=

# ── Cloudinary — NOT IN USE ─────────────────────────────────────────────────
# Anticipated for video transcoding only. Images are handled by Next's own
# optimizer, and Supabase Storage covers uploads, so this stays unset unless
# video actually happens. Do not create an account "just in case".
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
